# =============================================================================
# Trial Matcher — example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider configuration
# -----------------------------------------------------------------------------
# Default provider used when no override is passed. One of: azure | groq | ollama | openai
TRIAL_MATCHER__LLM__DEFAULT_PROVIDER=azure

# Azure OpenAI (primary for final eval)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_LARGE=gpt-5.4

# Groq (free tier — Llama 3.3 70B, 14400 req/day) — used as fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local (Qwen2.5 / Llama / etc.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b-instruct

# Plain OpenAI (rarely used — for embedding fallback or quick tests)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Inference behavior
# -----------------------------------------------------------------------------
TRIAL_MATCHER__LLM__TEMPERATURE_EXTRACT=0.0
TRIAL_MATCHER__LLM__TEMPERATURE_JUDGE=0.2
TRIAL_MATCHER__LLM__TEMPERATURE_SC=0.5
TRIAL_MATCHER__LLM__SC_K_SAMPLES=3
TRIAL_MATCHER__LLM__SC_CONFIDENCE_THRESHOLD=0.7
TRIAL_MATCHER__LLM__MAX_RETRIES=3
TRIAL_MATCHER__LLM__TIMEOUT_SECONDS=60
TRIAL_MATCHER__LLM__ENABLE_PROVIDER_FALLBACKS=false
TRIAL_MATCHER__LLM__ENABLE_OLLAMA_FALLBACK=false
TRIAL_MATCHER__LLM__MINI_IS_REASONING=true
TRIAL_MATCHER__LLM__LARGE_IS_REASONING=true
TRIAL_MATCHER__LLM__STRUCTURED_REASONING_EFFORT=minimal

# -----------------------------------------------------------------------------
# Retrieval configuration
# -----------------------------------------------------------------------------
TRIAL_MATCHER__RETRIEVAL__BM25_K1=1.5
TRIAL_MATCHER__RETRIEVAL__BM25_B=0.75
# Optional. For benchmark work, point this to a BM25 index built over the
# unfiltered TREC snapshot or an unfiltered local snapshot.
# TRIAL_MATCHER__RETRIEVAL__BM25_INDEX_DIR=data/indices/bm25_unfiltered_current
TRIAL_MATCHER__RETRIEVAL__BM25_MODE=single
# P9 fielded BM25/RRF benchmark mode.
# TRIAL_MATCHER__RETRIEVAL__FIELDED_BM25_INDEX_DIR=data/indices/bm25_trec2021_fielded
TRIAL_MATCHER__RETRIEVAL__FIELDED_BM25_PER_FIELD_K=1000
TRIAL_MATCHER__RETRIEVAL__FIELDED_RERANK_RETRIEVAL_BLEND=1.0
TRIAL_MATCHER__RETRIEVAL__BM25_TOP_K=200
TRIAL_MATCHER__RETRIEVAL__DENSE_TOP_K=200
TRIAL_MATCHER__RETRIEVAL__RRF_K=60
# Experimental knobs for weighted RRF. Keep equal weights by default; a
# BM25-heavy setting improved 20-topic validation but regressed 75-topic NDCG.
TRIAL_MATCHER__RETRIEVAL__BM25_RRF_WEIGHT=1.0
TRIAL_MATCHER__RETRIEVAL__DENSE_RRF_WEIGHT=1.0
TRIAL_MATCHER__RETRIEVAL__FUSED_TOP_K=100
TRIAL_MATCHER__RETRIEVAL__RERANK_TOP_K=50
TRIAL_MATCHER__RETRIEVAL__LISTWISE_TOP_K=30
TRIAL_MATCHER__RETRIEVAL__FINAL_TOP_K=30

# Models from HuggingFace
TRIAL_MATCHER__RETRIEVAL__MEDCPT_QUERY_ENCODER=ncbi/MedCPT-Query-Encoder
TRIAL_MATCHER__RETRIEVAL__MEDCPT_ARTICLE_ENCODER=ncbi/MedCPT-Article-Encoder
TRIAL_MATCHER__RETRIEVAL__MEDCPT_CROSS_ENCODER=ncbi/MedCPT-Cross-Encoder
TRIAL_MATCHER__RETRIEVAL__LISTWISE_MODEL=castorini/rank_zephyr_7b_v1_full

# Qdrant
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ctgov_trials_medcpt
# Server collection creation defaults tuned for the 321k MedCPT vectors.
QDRANT_TIMEOUT_SECONDS=120
QDRANT_ON_DISK_VECTORS=true
QDRANT_ON_DISK_HNSW=true
QDRANT_ON_DISK_PAYLOAD=true
# Docker Compose storage for server mode.
QDRANT_IMAGE=qdrant/qdrant:v1.17.1
QDRANT_SERVER_STORAGE=./qdrant_storage
QDRANT_SNAPSHOTS_DIR=./qdrant_snapshots
# Only enable embedded local mode for debugging small runs.
# QDRANT_PATH=data/indices/qdrant

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
TRIAL_MATCHER__PATHS__DATA_DIR=data
TRIAL_MATCHER__PATHS__CTGOV_DIR=data/ctgov_snapshot
TRIAL_MATCHER__PATHS__TREC_DIR=data/trec_ct
TRIAL_MATCHER__PATHS__MESH_DIR=data/mesh
TRIAL_MATCHER__PATHS__INDICES_DIR=data/indices
TRIAL_MATCHER__PATHS__CACHE_DIR=.cache

# -----------------------------------------------------------------------------
# Runner
# -----------------------------------------------------------------------------
TRIAL_MATCHER__RUNNER__MODE=benchmark
TRIAL_MATCHER__RUNNER__CONCURRENCY=8
TRIAL_MATCHER__RUNNER__USE_DENSE_RETRIEVAL=true
TRIAL_MATCHER__RUNNER__USE_HYDE=true
TRIAL_MATCHER__RUNNER__USE_LISTWISE=true
TRIAL_MATCHER__RUNNER__USE_VERIFIER=true
TRIAL_MATCHER__RUNNER__USE_FEW_SHOT=true
TRIAL_MATCHER__RUNNER__USE_SELF_CONSISTENCY=true
TRIAL_MATCHER__RUNNER__USE_LLM_JUDGE=true
TRIAL_MATCHER__RUNNER__USE_SELF_CRITIQUE=true
TRIAL_MATCHER__RUNNER__USE_QUESTIONS=true
TRIAL_MATCHER__RUNNER__USE_DOSSIERS=true
# Experimental: improves some ranking metrics on small runs but regressed
# 75-topic eligibility F1 in P5; keep off unless explicitly evaluating it.
TRIAL_MATCHER__RUNNER__USE_CRITERION_TRIAGE=false
# Experimental P6: merges useful CT.gov section headers into the following
# bullet and drops structural headers before LLM evaluation. Semantically
# cleaner, but current 75-topic metrics are slightly below the P3 baseline.
TRIAL_MATCHER__RUNNER__USE_SECTION_HEADER_POLICY=false
TRIAL_MATCHER__RUNNER__MAX_RETRIEVAL_ATTEMPTS=2
TRIAL_MATCHER__RUNNER__MAX_CRITIQUE_ITERATIONS=1
TRIAL_MATCHER__RUNNER__TOPIC_TIMEOUT_SECONDS=0
TRIAL_MATCHER__RUNNER__OUTPUT_TOP_K=20
TRIAL_MATCHER__RUNNER__MAX_TRIALS_PER_TOPIC=0
TRIAL_MATCHER__RUNNER__MAX_CRITERIA_PER_TRIAL=0
TRIAL_MATCHER__RUNNER__BENCHMARK_SOFT_VETO=false
TRIAL_MATCHER__RUNNER__BENCHMARK_INDEX_MANIFEST_POLICY=warn
TRIAL_MATCHER__RUNNER__USE_HARD_EXCLUDED_FILL=true
TRIAL_MATCHER__RUNNER__USE_RETRIEVAL_TAIL_FILL=false
TRIAL_MATCHER__RUNNER__INCLUDE_RETRIEVAL_TRACES=false
TRIAL_MATCHER__RUNNER__MIN_INCLUSION_FRACTION=0.6
TRIAL_MATCHER__RUNNER__MAX_NEI_FRACTION=0.6
TRIAL_MATCHER__RUNNER__BENCHMARK_MIN_INCLUSION_FRACTION=0.1
TRIAL_MATCHER__RUNNER__BENCHMARK_MAX_NEI_FRACTION=1.0
TRIAL_MATCHER__RUNNER__USE_IRRELEVANCE_HEURISTIC=false
TRIAL_MATCHER__RUNNER__IRRELEVANT_MIN_NEI_FRACTION=0.8
TRIAL_MATCHER__RUNNER__IRRELEVANT_MAX_INCLUSION_MET=0

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
TRIAL_MATCHER__TELEMETRY__LANGFUSE_HOST=
TRIAL_MATCHER__TELEMETRY__LANGFUSE_PUBLIC_KEY=
TRIAL_MATCHER__TELEMETRY__LANGFUSE_SECRET_KEY=
